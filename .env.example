# BatteryFlex uses a dedicated database. Existing previous-MVP variables are ignored for SQL.
BATTERYFLEX_STORAGE_MODE=cloud
# Select owner only in a private operator environment.
BATTERYFLEX_ACCESS_MODE=demo
BATTERYFLEX_TURSO_DATABASE_URL=libsql://batteryflex-mvp-your-organisation.turso.io
BATTERYFLEX_TURSO_AUTH_TOKEN=replace-with-dedicated-database-token
# Reuse existing account credentials if they can access ONLY the requested bucket operations.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=existing-r2-access-key-id
R2_SECRET_ACCESS_KEY=existing-r2-secret-access-key
# The application hardcodes the dedicated bucket name batteryflex-mvp.
# Optional bucket-scoped overrides; no new account/key is required if the above keys have access.
# BATTERYFLEX_R2_ACCESS_KEY_ID=
# BATTERYFLEX_R2_SECRET_ACCESS_KEY=
# BATTERYFLEX_STORAGE_DIRECTORY=outputs/persistent_storage
# Explicit local development: BATTERYFLEX_STORAGE_MODE=local; bootstrap first (see docs/STORAGE.md).

# Optional provisioning with an already authorised platform credential (never use a DB JWT here):
# BATTERYFLEX_TURSO_PLATFORM_TOKEN=
# BATTERYFLEX_TURSO_ORGANIZATION=
# TURSO_GROUP=default
